---
import PowerSwitch from './ui/PowerSwitch.astro';
const links = [
  { href: '#work', label: 'Work' },
  { href: '#projects', label: 'Projects' },
  { href: '#services', label: 'Services' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="top">
  <a class="id" href="#top">SUBODH KANT</a>
  <nav aria-label="Primary">
    <button type="button" class="menu" aria-expanded="false" aria-controls="primary-links">Menu</button>
    <ul id="primary-links">{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
  </nav>
  <PowerSwitch />
</header>

<style>
  .top { position: fixed; inset: 0 0 auto; z-index: 30; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 4vw;
    background: linear-gradient(var(--bg) 40%, color-mix(in srgb, var(--bg) 0%, transparent)); }
  .id { font: 800 20px var(--disp); font-stretch: 75%; letter-spacing: .02em; text-decoration: none; }
  nav { position: relative; }
  ul { display: flex; gap: 4px; padding: 6px; list-style: none; border-radius: 999px; background: var(--surface); box-shadow: var(--out); }
  ul a { display: block; text-decoration: none; font-weight: 600; font-size: 14px; padding: 8px 14px; border-radius: 999px; }
  ul a:hover, ul a:focus-visible { box-shadow: var(--in); }
  .menu { display: none; border: 0; cursor: pointer; font: 700 14px var(--disp); padding: 10px 16px; border-radius: 999px; background: var(--surface); box-shadow: var(--out); }
  @media (max-width: 960px) {
    .menu { display: block; }
    ul { display: none; position: absolute; top: calc(100% + 10px); left: 50%; translate: -50% 0; flex-direction: column; border-radius: 22px; min-width: 180px; }
    .menu[aria-expanded="true"] + ul { display: flex; }
    /* Without JS the menu button can't work: show the links inline instead. */
    :global(html:not(.js)) .menu { display: none; }
    :global(html:not(.js)) ul { display: flex; position: static; translate: none; flex-direction: row; flex-wrap: wrap; min-width: 0; border-radius: 22px; }
  }
</style>

<script>
  const menu = document.querySelector<HTMLButtonElement>('.top .menu')!;
  menu.addEventListener('click', () => menu.setAttribute('aria-expanded', String(menu.getAttribute('aria-expanded') !== 'true')));
  document.querySelectorAll('#primary-links a').forEach((a) => a.addEventListener('click', () => menu.setAttribute('aria-expanded', 'false')));
</script>
