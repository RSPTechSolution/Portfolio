---
import Meter from '../ui/Meter.astro';
const shifts = [
  { key: 'day', icon: '☀', kicker: 'Day shift · CMS', title: 'Enterprise Drupal platforms', big: 'D', roles: 'drupal php',
    items: ['Custom modules on Drupal 7 to 11', 'Views, Webforms, Layout Builder, Twig', 'Search API with Solr/OpenSearch', 'Upgrades and migrations'] },
  { key: 'night', icon: '☾', kicker: 'Night shift · systems', title: 'Real-time backends', big: '{ }', roles: 'backend ai',
    items: ['FastAPI microservices', 'Redis caching, queues and events', 'PostgreSQL analytics schemas', 'Docker, AWS and CI/CD'] },
];
---
<section id="shifts" class="section tight">
  <div class="wrap">
    <p class="kicker mono" data-reveal>Two shifts, one engineer</p>
    <h2 class="h2" data-reveal>What I <em>do</em>.</h2>
    <div class="shifts">
      {shifts.map((s) => (
        <button type="button" class={`card ${s.key}`} data-shift={s.key} data-roles={s.roles} data-reveal aria-label={`${s.title}: switch to ${s.key} mode`}>
          <span class="mono">{s.icon} {s.kicker}</span>
          <h3>{s.title}</h3>
          <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
          {s.key === 'night' && <Meter />}
          <span class="big" aria-hidden="true">{s.big}</span>
        </button>
      ))}
    </div>
  </div>
</section>

<style>
  .shifts { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; margin-top: 56px; }
  .card { position: relative; text-align: left; border: 0; cursor: pointer; border-radius: 34px; padding: 38px; min-height: 420px; display: flex; flex-direction: column; gap: 14px; overflow: hidden; transition: transform .45s var(--ease), opacity .4s, filter .4s; }
  .card:hover { transform: translateY(-8px) rotate(-.6deg); }
  .day { background: var(--butter); color: var(--ink); box-shadow: inset -10px -12px 22px rgba(150,100,0,.25), inset 10px 10px 18px rgba(255,255,255,.5), 14px 18px 34px rgba(0,0,0,.2); }
  .night { background: var(--screen); color: var(--cream); box-shadow: inset 0 0 0 1px #2e2a24, 14px 18px 34px rgba(0,0,0,.35); }
  .card .mono { color: inherit; }
  .night .mono { color: var(--amber); }
  h3 { font: 800 clamp(34px, 3.6vw, 52px)/.95 var(--disp); font-stretch: 75%; letter-spacing: -.03em; }
  ul { list-style: none; display: grid; gap: 8px; font-size: 16px; }
  li::before { content: "→ "; opacity: .6; }
  .big { position: absolute; right: -10px; bottom: -40px; font: 800 220px/1 var(--disp); font-stretch: 75%; opacity: .12; pointer-events: none; }
  .night :global(.vu) { margin-top: auto; }
  @media (max-width: 960px) { .shifts { grid-template-columns: 1fr; } .card { min-height: 0; } }
</style>

<script>
  import { setTheme } from '../../scripts/theme';
  document.querySelectorAll<HTMLButtonElement>('[data-shift]').forEach((b) => b.addEventListener('click', (e) => {
    void setTheme(b.dataset.shift as 'day' | 'night', { x: e.clientX, y: e.clientY });
  }));
</script>
