---
import { getCollection } from 'astro:content';
import PipelineSchematic from '../PipelineSchematic.astro';
const studies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
---
<section id="work" class="section tight">
  <div class="wrap">
    <p class="kicker mono" data-reveal>Featured work</p>
    <h2 class="h2" data-reveal>Case <em>studies</em>.</h2>
    <div class="studies">
      {studies.map((s, i) => (
        <a class="study" href={`/work/${s.data.slug}`} data-view data-reveal data-roles={s.data.roles.join(' ')}>
          <span class="num" aria-hidden="true">0{i + 1}</span>
          <div class="body">
            <h3>{s.data.title}</h3>
            <p>{s.data.summary}</p>
            <ul class="tags">{s.data.stack.slice(0, 5).map((t) => <li class="mono">{t}</li>)}</ul>
            <span class="more mono">Read the case study →</span>
          </div>
          {s.data.slug === 'ads-delivery-system' && <div class="viz"><PipelineSchematic /></div>}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .studies { display: grid; gap: 28px; margin-top: 56px; }
  .study { display: grid; grid-template-columns: 100px 1fr; gap: 30px; padding: 36px; border-radius: 34px; background: var(--surface); box-shadow: var(--out); text-decoration: none; transition: transform .45s var(--ease), opacity .4s, filter .4s; }
  .study:hover { transform: translateY(-6px); }
  .num { font: 800 90px/.8 var(--disp); font-stretch: 75%; color: transparent; -webkit-text-stroke: 1.5px var(--accent); }
  h3 { font: 800 clamp(32px, 3.8vw, 56px)/.95 var(--disp); font-stretch: 75%; letter-spacing: -.03em; }
  p { font-size: 18px; margin-top: 12px; max-width: 60ch; }
  .tags { list-style: none; display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
  .tags li { padding: 5px 10px; border-radius: 8px; box-shadow: var(--in); }
  .more { display: inline-block; margin-top: 18px; color: var(--accent-text); }
  .viz { grid-column: 1 / -1; padding: 24px; border-radius: 24px; box-shadow: var(--in); }
  @media (max-width: 760px) { .study { grid-template-columns: 1fr; padding: 24px; } .num { font-size: 60px; } }
</style>

<script>
  import { initPipeline } from '../../scripts/pipeline';
  document.querySelectorAll<SVGSVGElement>('[data-pipeline]').forEach(initPipeline);
</script>
