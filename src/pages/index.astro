---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/sections/Hero.astro';
import Ticker from '../components/sections/Ticker.astro';
import About from '../components/sections/About.astro';
import TwoShifts from '../components/sections/TwoShifts.astro';
import Stack from '../components/sections/Stack.astro';
import AiToolkit from '../components/sections/AiToolkit.astro';
import Experience from '../components/sections/Experience.astro';
import FeaturedWork from '../components/sections/FeaturedWork.astro';
---
<Base title="Subodh Kant — Backend & Drupal Engineer" description="Portfolio of Subodh Kant, Backend & Drupal Engineer in Ludhiana, India: enterprise Drupal platforms and real-time Python backends.">
  <TopBar slot="topbar" />
  <main id="top">
    <Hero />
    <Ticker />
    <About />
    <TwoShifts />
    <Stack />
    <AiToolkit />
    <Experience />
    <FeaturedWork />
  </main>
</Base>

<script>
  import { initReveal } from '../scripts/reveal';
  import { initClock } from '../scripts/clock';
  initReveal();
  initClock();
</script>
