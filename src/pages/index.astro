---
import Base from '../layouts/Base.astro';
import { HOME_SEO, graph, personSchema, websiteSchema, profilePageSchema, serviceSchema } from '../seo/schema';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/sections/Hero.astro';
import Ticker from '../components/sections/Ticker.astro';
import About from '../components/sections/About.astro';
import TwoShifts from '../components/sections/TwoShifts.astro';
import Stack from '../components/sections/Stack.astro';
import AiToolkit from '../components/sections/AiToolkit.astro';
import Experience from '../components/sections/Experience.astro';
import FeaturedWork from '../components/sections/FeaturedWork.astro';
import Projects from '../components/sections/Projects.astro';
import MoreWork from '../components/sections/MoreWork.astro';
import Services from '../components/sections/Services.astro';
import Awards from '../components/sections/Awards.astro';
import Learning from '../components/sections/Learning.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';
const site = Astro.site!.href;
const seo = {
  ...HOME_SEO, path: '/', ogImage: '/og/home.png', ogType: 'profile' as const,
  jsonLd: graph(personSchema(site), websiteSchema(site), profilePageSchema(site), serviceSchema(site)),
};
---
<Base seo={seo}>
  <TopBar slot="topbar" />
  <main id="top">
    <Hero />
    <Ticker />
    <About />
    <TwoShifts />
    <Stack />
    <AiToolkit />
    <Experience />
    <FeaturedWork />
    <Projects />
    <MoreWork />
    <Services />
    <Awards />
    <Learning />
    <Contact />
  </main>
  <Footer />
</Base>

<script>
  import { initReveal } from '../scripts/reveal';
  import { initClock } from '../scripts/clock';
  initReveal();
  initClock();
</script>
