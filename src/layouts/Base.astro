---
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/martian-mono/300.css';
import '@fontsource/martian-mono/400.css';
import '@fontsource/martian-mono/600.css';
import '../styles/tokens.css';
import '../styles/global.css';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wdth-normal.woff2?url';

import Seo, { type SeoProps } from '../components/Seo.astro';
interface Props { seo: SeoProps }
const { seo } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="day" data-role="all">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...seo} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement, keys = ['all', 'drupal', 'php', 'backend', 'ai'];
        d.classList.add('js');
        try { if (localStorage.getItem('sk-theme') === 'night') d.dataset.theme = 'night'; } catch (e) {}
        try { var r = (new URLSearchParams(location.search).get('role') || '').trim().toLowerCase(); if (keys.indexOf(r) > -1) d.dataset.role = r; } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot name="topbar" />
    <slot />
    <div id="cursor" aria-hidden="true"></div>
    <script>
      import { initCursor } from '../scripts/cursor';
      initCursor();
    </script>
  </body>
</html>
