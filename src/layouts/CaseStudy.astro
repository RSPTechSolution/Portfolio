---
import Base from './Base.astro';
import TopBar from '../components/TopBar.astro';
import PipelineSchematic from '../components/PipelineSchematic.astro';
interface Props {
  title: string; summary: string; slug: string; stack: string[];
  prev?: { slug: string; title: string }; next?: { slug: string; title: string };
}
const { title, summary, slug, stack, prev, next } = Astro.props;
---
<Base title={`${title} — Subodh Kant`} description={summary}>
  <TopBar slot="topbar" />
  <main id="top" class="cs">
    <div class="wrap">
      <a class="back mono" href="/#work">← All work</a>
      <h1>{title}</h1>
      <p class="sum">{summary}</p>
      <ul class="stack">{stack.map((s) => <li class="mono">{s}</li>)}</ul>
      {slug === 'ads-delivery-system' && <div class="viz"><PipelineSchematic /></div>}
      <article class="prose"><slot /></article>
      <nav class="pn" aria-label="More case studies">
        {prev && <a href={`/work/${prev.slug}`}>← {prev.title}</a>}
        {next && <a href={`/work/${next.slug}`}>{next.title} →</a>}
      </nav>
    </div>
  </main>
</Base>

<style>
  .cs { padding: 130px 0 100px; }
  .back { text-decoration: none; color: var(--accent-text); }
  h1 { font: 800 clamp(56px, 9vw, 140px)/.85 var(--disp); font-stretch: 75%; letter-spacing: -.04em; margin-top: 20px; }
  .sum { font: 400 clamp(20px, 2vw, 26px)/1.35 var(--serif); font-style: italic; margin-top: 20px; max-width: 40ch; }
  .stack { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .stack li { padding: 6px 10px; border-radius: 8px; box-shadow: var(--in); }
  .viz { margin-top: 40px; padding: 24px; border-radius: 24px; box-shadow: var(--in); }
  .prose { margin-top: 50px; max-width: 70ch; font-size: 18px; line-height: 1.6; }
  .prose :global(h2) { font: 800 clamp(30px, 3vw, 44px)/1 var(--disp); font-stretch: 75%; margin: 44px 0 12px; }
  .pn { display: flex; justify-content: space-between; gap: 20px; margin-top: 70px; padding-top: 24px; border-top: 2px solid var(--line); }
  .pn a { font: 700 18px var(--disp); text-decoration: none; }
  .pn a:hover { color: var(--accent-text); }
</style>

<script>
  import { initPipeline } from '../scripts/pipeline';
  document.querySelectorAll<SVGSVGElement>('[data-pipeline]').forEach(initPipeline);
</script>
